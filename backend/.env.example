
PORT=5000

# MongoDB Connection
# Local: mongodb://localhost:27017/smartbdu
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/smartbdu
MONGODB_URI=mongodb://localhost:27017/smartbdu

# JWT Secret (generate a strong random string for production)
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# AI Provider: 'huggingface' or 'ollama'
# RECOMMENDED: 'ollama' for free, local, private AI
# Free tier works with smaller models; Pro tier needed for Mistral 7B
AI_PROVIDER=ollama

# Hugging Face API (Cloud-based - requires API key)
# Get free key: https://huggingface.co/settings/tokens
HF_API_KEY=hf_your-api-key-here
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Ollama Configuration (Local AI - RECOMMENDED)
# Install from: https://ollama.ai
# Then download model: ollama pull mistral
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
