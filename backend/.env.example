
PORT=5000
FRONTEND_URL=http://localhost:3000

# MongoDB Connection
# Local: mongodb://localhost:27017/smartbdu
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/smartbdu
MONGODB_URI=mongodb://localhost:27017/smartbdu

# JWT Secret (generate a strong random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# AI Provider: 'huggingface' or 'ollama'
# RECOMMENDED: 'ollama' for free, local, private AI
# Free tier works with smaller models; Pro tier needed for Mistral 7B
AI_PROVIDER=ollama

# Hugging Face API Key (free tier available)
# Get your token from: https://huggingface.co/settings/tokens
HF_API_KEY=hf_your-huggingface-token-here

# Ollama Configuration (if AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
